# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
uv.lock

# Type & lint caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editor
.idea/
.vscode/
*.swp

# Environment — any .env* file is excluded; only .env.example is tracked.
# Real credentials must never sit inside the repo tree.
.env*
!.env.example

# Persisted session cookies (COOKIDOUGH_COOKIES_FILE) hold live
# session credentials — equivalent to a password.
*.cookies.json
cookies.json

# Locally generated/downloaded recipe media is account-specific and can be
# re-created from its source; do not commit it with the implementation.
assets/

# OS
.DS_Store
Thumbs.db
